# Frontend
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-project-subdomain
NEXT_PUBLIC_NHOST_REGION=your-region
# Optional URL overrides for local/self-hosted Nhost
NEXT_PUBLIC_NHOST_AUTH_URL=
NEXT_PUBLIC_NHOST_GRAPHQL_URL=
NEXT_PUBLIC_NHOST_FUNCTIONS_URL=

# Nhost Functions: these are injected by Nhost in production/local CLI.
# NHOST_ADMIN_SECRET=
# NHOST_WEBHOOK_SECRET=
# NHOST_GRAPHQL_URL=
# NHOST_FUNCTIONS_URL=

# Custom backend settings
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_STUB_DELAY_MS=900
HTTP_REQUEST_ALLOWED_HOSTS=httpbin.org,jsonplaceholder.typicode.com
ALLOW_UNSAFE_HTTP_REQUESTS=false
SLACK_WEBHOOK_URL=

# Hasura metadata webhook envs (set in the Nhost project environment)
WORKFLOW_TRIGGER_ACTION_WEBHOOK=https://YOUR_SUBDOMAIN.functions.YOUR_REGION.nhost.run/v1/trigger-workflow-run
WORKFLOW_APPROVAL_ACTION_WEBHOOK=https://YOUR_SUBDOMAIN.functions.YOUR_REGION.nhost.run/v1/approve-step
WORKFLOW_INBOUND_ACTION_WEBHOOK=https://YOUR_SUBDOMAIN.functions.YOUR_REGION.nhost.run/v1/workflow-webhook-action
WORKFLOW_EXECUTOR_WEBHOOK=https://YOUR_SUBDOMAIN.functions.YOUR_REGION.nhost.run/v1/execute-workflow-run
SCHEDULED_WORKFLOW_WEBHOOK=https://YOUR_SUBDOMAIN.functions.YOUR_REGION.nhost.run/v1/scheduled-workflows
DATABASE_EVENT_WEBHOOK=https://YOUR_SUBDOMAIN.functions.YOUR_REGION.nhost.run/v1/database-event-trigger
NOTIFICATION_WEBHOOK=https://YOUR_SUBDOMAIN.functions.YOUR_REGION.nhost.run/v1/send-notification
